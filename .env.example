# Copy the line you need into .env.local (ignored by Git), then restart Metro
# with `npx expo start --clear`. Release builds always use the live server
# (https://papers-jet.vercel.app), whatever is set here.
#
# Leave EXPO_PUBLIC_API_URL unset to use the live server in development too.
#
# The papers API on this computer (start it with `npm run dev:local` in ../papers):
#   local       a phone on the same Wi-Fi reaches this computer at the address Metro shows;
#               the Android emulator uses 10.0.2.2; the iOS simulator uses localhost
#   local:4000  the same, if the API runs on another port
# EXPO_PUBLIC_API_URL=local
#
# Or any address, e.g. a server on the network (don't commit your own address):
# EXPO_PUBLIC_API_URL=http://<this-computer's-LAN-IP>:3000
